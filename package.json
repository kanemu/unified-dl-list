{
    "name": "unified-dl-list",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.27.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/kanemu/unified-dl-list"
    },
    "homepage": "https://github.com/kanemu/unified-dl-list",
    "bugs": {
        "url": "https://github.com/kanemu/unified-dl-list/issues"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "pnpm -r --if-present build",
        "test": "pnpm -r --if-present test",
        "typecheck": "pnpm -r --if-present typecheck",
        "clean": "pnpm -r --if-present clean",
        "test:ha": "pnpm -F hast-util-dl-list test",
        "test:md": "pnpm -F mdast-util-dl-list test",
        "test:mi": "pnpm -F micromark-extension-dl-list test",
        "test:re": "pnpm -F remark-dl-list test",
        "prepublish:check": "pnpm clean && pnpm build && pnpm typecheck && pnpm test"
    },
    "devDependencies": {
        "@types/node": "^25.0.3",
        "hast-util-dl-list": "workspace:*",
        "hast-util-to-html": "^9.0.5",
        "mdast-util-dl-list": "workspace:*",
        "mdast-util-from-markdown": "^2.0.2",
        "mdast-util-to-hast": "^13.2.1",
        "mdast-util-to-markdown": "^2.1.2",
        "micromark": "^4.0.2",
        "micromark-extension-dl-list": "workspace:*",
        "rehype-stringify": "^10.0.1",
        "remark": "^15.0.1",
        "remark-dl-list": "workspace:*",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.0.0",
        "remark-stringify": "^11.0.0",
        "rimraf": "^6.1.2",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^5.4.0",
        "unified": "^11.0.5"
    }
}